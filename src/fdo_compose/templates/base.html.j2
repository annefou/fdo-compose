<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ d.name }}{% endblock %}</title>
<link rel="stylesheet" href="static/style.css">
<style>:root { --primary: {{ d.colour }}; }</style>
</head>
<body>
<header class="bar">
  <span class="home">{{ d.name }}</span>
  <nav>
    <a href="index.html" class="{{ 'on' if page == 'index.html' }}">The FAIR Digital Object</a>
    <a href="dashboard.html" class="{{ 'on' if page == 'dashboard.html' }}">The dashboard it describes</a>
  </nav>
</header>
<main>
{% block content %}{% endblock %}
</main>
<footer>
  Built {{ built }} by <a href="https://github.com/annefou/fdo-compose">fdo-compose</a>, which reads the objects with
  <a href="https://github.com/FAIR2Adapt/fdo-consume">fdo-consume</a> through the draft profile map
  <code>cca-dashboard-0.1</code>. Nothing on these pages is configured in the code: every value comes from annotations
  on the Research Objects in ROHub.
</footer>
<script>
// The Science Live embed reports its height; let each nanopublication iframe grow to fit.
window.addEventListener("message", function (event) {
  if (!event.data || event.data.type !== "nanopub-embed-resize") return;
  document.querySelectorAll("figure.np iframe").forEach(function (frame) {
    if (frame.contentWindow === event.source) frame.style.height = event.data.height + "px";
  });
});
</script>
</body>
</html>
